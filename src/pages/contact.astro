---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../lib/blog-data.js";
import { CONTACT } from "../config/theme.config.ts";

---

<BaseLayout
  title={`Contact - ${SITE.name}`}
  description={`Get in touch with ${SITE.name}.`}
  canonical="/contact"
>
  <div class="mx-auto max-w-3xl px-5 py-12">
    <Breadcrumbs items={[{ label: "Home", to: "/" }, { label: "Contact" }]} />

    <header class="mt-6">
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Contact</div>
      <h1 class="mt-2 font-serif text-5xl font-semibold">Say hello.</h1>
      <p class="mt-4 max-w-xl text-muted-foreground">
        Notes, corrections, or just a thought. I read everything.
      </p>
    </header>

    <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_240px]">

      <aside class="space-y-6 border-l border-border pl-8 lg:block">
        <div>
          <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Find Me Here</div>
          <ul class="mt-3 space-y-3 text-sm">
            <li><a href={`mailto:${CONTACT.email}`} class="flex items-center gap-2 hover:text-primary"><Icon name="mail" class="h-3.5 w-3.5" /> {CONTACT.email}</a></li>
            <li><a href={CONTACT.socialUrl} class="flex items-center gap-2 hover:text-primary"><Icon name="twitter" class="h-3.5 w-3.5" /> {CONTACT.socialHandle}</a></li>
            <li><a href="/rss.xml" class="flex items-center gap-2 hover:text-primary"><Icon name="rss" class="h-3.5 w-3.5" /> RSS feed</a></li>
          </ul>
        </div>
        
      </aside>
    </div>
  </div>
</BaseLayout>
