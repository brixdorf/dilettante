---
import { Image } from "astro:assets";
import type { Author } from "@/config/authors";

interface Props {
  author: Author;
  /** Rendered size in CSS pixels. */
  size?: number;
  class?: string;
}

const { author, size = 28, class: className } = Astro.props;
const classes = ["shrink-0 rounded-full bg-sunken object-cover", className];
---

{/* A drawing in public/ (an SVG) is used as it is; a photo goes through Astro's image pipeline. */}
{typeof author.avatar === "string" ? (
  <img
    src={author.avatar}
    alt=""
    width={size}
    height={size}
    class:list={classes}
    style={`width:${size}px;height:${size}px`}
  />
) : (
  <Image
    src={author.avatar}
    alt=""
    width={size}
    height={size}
    densities={[1, 2]}
    quality={80}
    class:list={classes}
    style={`width:${size}px;height:${size}px`}
  />
)}
