---
// A picture written in plain Markdown inside a post (![alt](./file.png)), shown as a <picture>
// across the reading column. The lightbox opens it when clicked.
import type { ImageMetadata } from "astro";
import Picture from "@/components/ui/Picture.astro";

interface Props {
  src: ImageMetadata | string;
  alt?: string;
}

const { src, alt = "" } = Astro.props;
---

{typeof src === "string" ? (
  <img src={src} alt={alt} loading="lazy" decoding="async" />
) : (
  <Picture src={src} alt={alt} sizes="(min-width: 48rem) 42rem, 92vw" />
)}
