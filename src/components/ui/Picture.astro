---
// An image as a <picture>: JPEG XL and AVIF where they are smaller, smallest first, then the
// image's own format for every other browser, at every width it was made in (src/lib/pictures.ts).
// Width and height are always set, so the page never moves while it loads. In the dev server, an
// image whose pictures are still being made shows as a plain optimized image for the moment.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { pictureFor } from "@/lib/pictures";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** How wide the image shows, for the browser to pick a width (the HTML sizes attribute). */
  sizes: string;
  class?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  style?: string;
}

const { src, alt, sizes, class: className, loading = "lazy", fetchpriority, style } = Astro.props;
const record = pictureFor(src);
---

{record ? (
  <picture>
    {record.sources.map((source) => (
      <source type={source.type} srcset={source.srcset} sizes={sizes} />
    ))}
    <img
      src={record.fallback.src}
      srcset={record.fallback.srcset}
      sizes={sizes}
      width={record.width}
      height={record.height}
      alt={alt}
      loading={loading}
      decoding={loading === "eager" ? "auto" : "async"}
      fetchpriority={fetchpriority}
      class={className}
      style={style}
    />
  </picture>
) : (
  <Image
    src={src}
    alt={alt}
    sizes={sizes}
    loading={loading}
    fetchpriority={fetchpriority}
    class={className}
    style={style}
  />
)}
