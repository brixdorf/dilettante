    "@jsquash/jxl": "1.3.0",
    "@keystatic/astro": "6.0.0",
    "@keystatic/core": "0.6.9",
    "@tailwindcss/vite": "4.3.5",
    "@types/js-yaml": "4.0.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.4.11",
    "js-yaml": "4.3.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.65.0",
