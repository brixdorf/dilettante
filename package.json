{
  "name": "dilettante",
  "version": "2.1.0",
  "description": "A digital recollection of my ramblings",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/prune-unused-assets.mjs",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:browsers": "playwright test",
    "smoke": "playwright test --project=chromium --project=keystatic"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.5",
    "@astrojs/node": "^11.1.12",
    "@astrojs/react": "^7.1.8",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "@tailwindcss/vite": "^4.3.5",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.11",
    "js-yaml": "^4.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "prettier": "^3.10.1",
    "vite": "^8.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "26.x"
  }
}
