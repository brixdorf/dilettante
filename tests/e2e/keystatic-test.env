# Made-up Keystatic settings so its GitHub mode can start in the built blog during the browser
# tests. They open nothing. The real ones live only in Dokploy. The tests give these to the
# running server only, not to the build, the same way Dokploy provides them.
KEYSTATIC_GITHUB_CLIENT_ID=test-client-id
KEYSTATIC_GITHUB_CLIENT_SECRET=test-client-secret
KEYSTATIC_SECRET=test-secret-that-is-at-least-32-characters-long
